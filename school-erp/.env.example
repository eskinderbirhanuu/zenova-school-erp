# ZENOVA School ERP — Environment Configuration
# ==============================================
# Copy to .env and fill in your values.

# REQUIRED — obtain from ZENOVA
ZENOVA_LICENSE_KEY=your-license-key-here
ZENOVA_LICENSE_SERVER=https://superadmin.free.nf
SCHOOL_ID=your-school-id

# REQUIRED — generate strong values
SECRET_KEY=generate-a-random-64-char-string
DB_PASSWORD=generate-a-strong-password

# OPTIONAL — ports (defaults shown)
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
REDIS_PORT=6379

# OPTIONAL — resource limits
DB_MEM_LIMIT=512M
REDIS_MEM_LIMIT=256M

# OPTIONAL — URLs (change for production domain)
API_URL=http://localhost:8000/api/v1
WS_URL=ws://localhost:8000/ws
ALLOWED_ORIGINS=http://localhost:3000
