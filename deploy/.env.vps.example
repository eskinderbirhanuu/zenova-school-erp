# ZENOVA School ERP — VPS Environment
# Copy to .env.vps and edit

DOMAIN=zenova.example.com
DOMAIN_URL=https://${DOMAIN}

# Database
DB_USER=zenova
DB_PASSWORD=CHANGE_ME_DB_PASSWORD_32_CHARS_MIN
DB_NAME=zenova_prod

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_32_CHARS

# Security
SECRET_KEY=CHANGE_ME_SECRET_KEY_64_CHARS_MIN

# License (fill these during setup)
ZENOVA_LICENSE_KEY=
ZENOVA_LICENSE_SERVER=https://superadmin.free.nf
SCHOOL_ID=

# Version
ZENOVA_VERSION=latest
