# ZENOVA Control Center — VPS Environment (PRIVATE)
# Copy to .env.cc and edit
# WARNING: This admin panel is PRIVATE. Never share these credentials.

CC_DOMAIN=admin.zenova.example.com
CC_DOMAIN_URL=https://${CC_DOMAIN}

# Database
CC_DB_USER=cc_admin
CC_DB_PASSWORD=CHANGE_ME_CC_DB_PASSWORD_32_CHARS
CC_DB_NAME=zenova_control

# Security
CC_SECRET_KEY=CHANGE_ME_CC_SECRET_KEY_64_CHARS_MIN

# Admin credentials (change at first login)
CC_ADMIN_EMAIL=admin@zenova.et
CC_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_12_CHARS
